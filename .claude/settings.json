{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/niagara-research-protocol.sh",
            "timeout": 10,
            "statusMessage": "Loading Niagara research protocol..."
          }
        ]
      }
    ]
  }
}
