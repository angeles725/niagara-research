fox.legacy.relaxed.expiring=FoxService relaxed legacy authentication will expire on {0}
fox.legacy.relaxed.expired=FoxService relaxed legacy authentication has expired
fox.legacy.cannotAuth=Cannot authenticate legacy clients
fox.authScheme.unsupported=Station requested an authentication scheme ("{0}") not supported by the client.

fox.user.password.expiring=Your password expires {0}. Would you like to reset it now?
fox.network.user.password.expiring=Your password expires {0}. However, since\nyour user account is centrally managed on another station, you\nmust log in to that station first to reset your password.
fox.insecure.password.expiring=Your password expires {0}. However, your station\nonly allows password resets over secure connections. Please try again\nover a secure connection or contact your system administrator.
fox.login.password.expirationTitle=Password Expiration
fox.login.passwordResetMessage.dialog.ok=OK
fox.login.passwordResetMessage.dialog.No=No
fox.login.passwordResetMessage.dialog.Yes=Yes

fox.illegal.network.user.passwordReset=Your station user account requires a password reset.\nHowever, since your user account is centrally managed on another station,\nplease log in to that station first and reset your password there before logging in to this station.
fox.login.passwordReset.secureOnly=Your station user account requires a password reset.\nHowever, your station only allows password resets over secure connections.\nPlease try again over a secure connection or contact your system administrator.

