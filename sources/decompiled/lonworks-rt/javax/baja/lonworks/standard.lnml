 <CpLogRecord type="XCpTypeDef">
  <init v="00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"/>
  <!-- Specifies whether or not a timestamp is included, and if it is included,
       specifies the format of the timestamp. Contents defined by timestampT. -->
  <elem n="timestampType" qual="ub byt=0 bit=6 len=2"/>
  <elem n="recordType" qual="ub byt=0 bit=3 len=3 max=3.0"/>
  <elem n="multipleInput" qual="ub byt=0 bit=2 len=1"/>
  <elem n="fanIn" qual="ub byt=0 bit=1 len=1"/>
  <elem n="pointStatus" qual="ub byt=0 bit=0 len=1"/>
  <elem n="dataLength" qual="u8"/>
  <!-- Full timestamp. Only present if timestamp_type is TS_FULL. -->
  <elem u="timestamp" n="timeTimestamp" qual="ref type=TimeStampP byt=2"/>
  <!-- Offset since last full timestamp. Only present if timestamp_type is TS_OFFSET. -->
  <elem u="offset_stamp" n="timeOffsetStamp" qual="u16 byt=2 res=0.01 max=655.33997 invld=65535.0" engUnit="second"/>
  <elem n="memberIndex" qual="u8 byt=7 min=1.0 invld=0.0"/>
  <elem n="dataSourceIndex" qual="s16 byt=8 min=0.0 invld=-1.0"/>
  <elem u="log_status" n="dataLogStatus" qual="e8" enumDef="LogStatusT"/>
  <elem u="value" n="dataValue" qual="s32 byt=10 invld=0.0"/>
  <elem u="old_time" n="dataOldTime" qual="ref type=TimeStampP byt=10"/>
  <elem n="pointStatusValue" qual="e8" enumDef="PointStatusT"/>
  <typeScope v="0,337"/>
   <!--
  <union>
   <branchElem v="timestampType"/>
     <tsFull v="0"/>
     <tsOffset v="1"/>
     <tsNone v="2"/>
   <branch n="timestamp" c="0"/>
   <branch n="offset_stamp" c="1"/>
   
   <branch n="log_status" c="??"/>
   <branch n="value" c="??"/>
   <branch n="old_time" c="??"/>
  </union>
    -->
 </CpLogRecord> 
